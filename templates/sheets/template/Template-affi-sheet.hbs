<section>

    <div class="itemRow5">
        <div class="browserImgBox4"><img class="browserImg" name="{{item.name}}" data-edit="img" data-action="editImage" src="{{item.img}}" /></div>
        <div class="spHelper1"><b>{{localize "GDSA.itemsheet.name"}}</b></div>
        <div class="spHelper46"><input class="spHelper2" name="name" type="text" value="{{item.name}}" /></div>
        <div class="spHelper1"><b>{{localize "GDSA.template.type"}}</b></div>
        <div class="spHelper46" style="margin-bottom: -3px;">
            <select class="spHelper33" name="system.type">{{selectOptions config.tempTypes selected=system.type blank="" localize=true}}</select>
        </div>  
    </div>

    <div class="itemMenu6">
        <nav class="tabs nav spell-tabs" data-group="spell">
            <a class="item" data-tab="spellNotes"><div class="spellMenu3">{{localize "GDSA.itemsheet.description"}}</div></a>
            <a class="item" data-tab="spellDetails"><div class="spellMenu4">{{localize "GDSA.template.general"}}</div></a>
        </nav>
    </div>

    <div class="spellMenuBox">
	    <section class="spell-body">
     
            <div class="tab spellNotes" data-group="spell" data-tab="spellNotes">
                <textarea class="areaInputDesc" name="system.tale.description">{{system.tale.description}}</textarea>
                <button class="noteBnt" data-action="postGM">{{localize "GDSA.charactersheet.postGM"}}</button>
                <button class="noteBnt" data-action="postAll">{{localize "GDSA.charactersheet.postAll"}}</button>
            </div>
            
            <div class="tab spellDetails" data-group="spell" data-tab="spellDetails">                
                <div class="input100 coloPickLbl">{{localize "GDSA.templates.state"}}:</div>
                <select class="inputTempColo" name="system.affi.type">{{selectOptions config.affilation selected=system.affi.type blank="" localize=true}}</select>
                <div class="input100 coloPickLbl">{{localize "GDSA.templates.fontC"}}:</div>
                <input class="coloPickTemplate" name="system.affi.fontColo" type="color" value="{{system.affi.fontColo}}" />
                <div class="input100 coloPickLbl">{{localize "GDSA.templates.backC"}}:</div>
                <input class="coloPickTemplate" name="system.affi.backgroundColor" type="color" value="{{system.affi.backgroundColor}}" />
            </div>

        </section>
    </div>
 
    <button class="adBnt" data-action="close">{{localize "GDSA.charactersheet.closeLabel"}}</button>

</section>