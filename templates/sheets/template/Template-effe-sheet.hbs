<section>

    <div class="itemRow5">
        <div class="ritHelper7">
            <div class="spHelper1"><b>{{localize "GDSA.itemsheet.name"}}</b></div>
            <div class="spHelper36"><b>{{localize "GDSA.template.type"}}</b></div>
            <div class="spHelper46"><input class="spHelper2" name="name" type="text" value="{{item.name}}" /></div>
            <div class="spHelper3">
                <select class="spHelper33" name="system.type">{{selectOptions config.tempTypes selected=system.type blank="" localize=true}}</select>
            </div>
        </div>    
    </div> 

    <div class="itemMenu7">
        <nav class="tabs nav spell-tabs" data-group="spell">
            <a class="item" data-tab="spellNotes"><div class="spellMenu2">{{localize "GDSA.template.general"}}</div></a>
        </nav>
    </div>

    <div class="spellMenuBox3">
	    <section class="spell-body">

            <div class="tab spellNotes" data-group="spell" data-tab="spellNotes">                
                <div class="effectAdd"><a class="effect-control" data-action="create"><i class="fas fa-plus"></i></a></div>
                
                <ol style="float: left;">
                    {{#each effects as |effect|}}
                        <li class="item effect" data-effect-id="{{effect._id}}">
                            <div class="item-name effect-name2">{{effect.name}}</div>
                            <div class="effect-controls">
                                <a class="effect-control" data-action="edit" title="{{localize 'GDSA.system.edit'}}">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a class="effect-control" data-action="delete" title="{{localize 'GDSA.system.delete'}}">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </li>
                    {{/each}}
                </ol>

            </div>

        </section>
    </div>
 
    <button class="adBnt" data-action="close">{{localize "GDSA.charactersheet.closeLabel"}}</button>

</section>