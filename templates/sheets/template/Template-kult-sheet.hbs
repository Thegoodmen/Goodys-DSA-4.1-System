<section>

    <div class="itemRow5">
        <div class="ritHelper7">
            <div class="spHelper1"><b>{{localize "GDSA.itemsheet.name"}}</b></div>
            <div class="spHelper36"><b>{{localize "GDSA.template.type"}}</b></div>
            <div class="spHelper46"><input class="spHelper2" name="name" type="text" value="{{item.name}}" /></div>
            <div class="spHelper3">
                <select class="spHelper33" name="system.type">{{selectOptions config.tempTypes selected=system.type blank="" localize=true}}</select>
            </div>
        </div>
        
        <div class="itemRow3">
            <div class="spHelper43"><b>{{localize "GDSA.itemsheet.cult"}}</b></div>
            <div class="spHelper36"><b>{{localize "GDSA.template.gradZero"}}</b></div>
            <div class="spHelper43">
                <select class="spHelper44" name="system.cult.type">{{selectOptions config.cultTypes selected=system.cult.type localize=true}}</select>
            </div>
            <div class="spHelper3">
                <select class="spHelper45" name="system.cult.gradZero">{{selectOptions template.liturgy.grad1 selected=system.cult.gradZero valueAttr="id" labelAttr="name" blank=""}}</select>
            </div>
        </div>
    </div>

    <div class="itemMenu6">
        <nav class="tabs nav spell-tabs" data-group="spell">
            <a class="item" data-tab="spellNotes"><div class="spellMenu3">{{localize "GDSA.itemsheet.description"}}</div></a>
            <a class="item" data-tab="spellVariants"><div class="spellMenu4">{{localize "GDSA.template.mirakel"}}</div></a>
        </nav>
    </div>

    <div class="spellMenuBox">
	    <section class="spell-body">
     
            <div class="tab spellNotes" data-group="spell" data-tab="spellNotes">
                <textarea class="areaInputDesc" name="system.tale.description">{{system.tale.description}}</textarea>
                <button class="noteBnt" data-action="postGM">{{localize "GDSA.charactersheet.postGM"}}</button>
                <button class="noteBnt" data-action="postAll">{{localize "GDSA.charactersheet.postAll"}}</button>
            </div>

            <div class="tab spellVariants" data-group="spell" data-tab="spellVariants">

                <div class="skillFiller"></div>
                <div class="form-group subSub">
                    <div class="submen"><hr class="subhr" /></div><span class="submenlbl">{{localize "GDSA.charactersheet.attributes"}}</span><div class="submen"><hr class="subhr" /></div>
                </div>
                <div class="skillFiller"></div>

                {{#each config.attributes as |name type|}}
                    <span class="nameSpan">{{localize (concat "GDSA.charactersheet." name "")}}
                        <select class="SelHelper2" name="system.cult.{{localize (concat "GDSA.charactersheet." name "")}}">
                            {{selectOptions ../config.mirDis selected=(getData ../system/cult (localize (concat "GDSA.charactersheet." name ""))) blank="" localize=true}}
                        </select>  
                    </span><br />
                {{/each}}

                <span class="nameSpan">{{localize "GDSA.charactersheet.MR"}}
                    <select class="SelHelper2" name="system.cult.{{localize "GDSA.charactersheet.MR"}}">
                        {{selectOptions config.mirDis selected=(getData system/cult (localize "GDSA.charactersheet.MR")) blank="" localize=true}}
                    </select> 
                </span> <br />

                <span class="nameSpan">{{localize "GDSA.charactersheet.dogde"}}
                    <select class="SelHelper2" name="system.cult.{{localize "GDSA.charactersheet.dogde"}}">
                        {{selectOptions config.mirDis selected=(getData system/cult (localize "GDSA.charactersheet.dogde")) blank="" localize=true}}
                    </select> 
                </span> <br />

                <div class="skillFiller"></div>
                <div class="form-group subSub">
                    <div class="submen"><hr class="subhr" /></div><span class="submenlbl">{{localize "GDSA.charactersheet.meeleSkills"}}</span><div class="submen"><hr class="subhr" /></div>
                </div>
                <div class="skillFiller"></div>

                {{#each template.talents.meele as |item|}}
                    <span class="nameSpan">{{skillName item.name ../this}}<select class="SelHelper2" name="system.cult.{{item.name}}">
                        {{selectOptions ../config.mirDis selected=(getData ../system/cult item.name) blank="" localize=true}}
                    </select></span> <br />
                {{/each}}

                <div class="skillFiller"></div>
                <div class="form-group subSub">
                    <div class="submen"><hr class="subhr" /></div><span class="submenlbl">{{localize "GDSA.charactersheet.rangeSkills"}}</span><div class="submen"><hr class="subhr" /></div>
                </div>
                <div class="skillFiller"></div>

                {{#each template.talents.range as |item|}}
                    <span class="nameSpan">{{skillName item.name ../this}}<select class="SelHelper2" name="system.cult.{{item.name}}">
                        {{selectOptions ../config.mirDis selected=(getData ../system/cult item.name) blank="" localize=true}}
                    </select></span> <br />
                {{/each}}

                <div class="skillFiller"></div>
                <div class="form-group subSub">
                    <div class="submen"><hr class="subhr" /></div><span class="submenlbl">{{localize "GDSA.charactersheet.bodySkills"}}</span><div class="submen"><hr class="subhr" /></div>
                </div>
                <div class="skillFiller"></div>

                {{#each template.talents.body as |item|}}
                    <span class="nameSpan">{{skillName item.name ../this}}<select class="SelHelper2" name="system.cult.{{item.name}}">
                        {{selectOptions ../config.mirDis selected=(getData ../system/cult item.name) blank="" localize=true}}
                    </select></span> <br />
                {{/each}}

                <div class="skillFiller"></div>
                <div class="form-group subSub">
                    <div class="submen"><hr class="subhr" /></div><span class="submenlbl">{{localize "GDSA.charactersheet.socialSkills"}}</span><div class="submen"><hr class="subhr" /></div>
                </div>
                <div class="skillFiller"></div>

                {{#each template.talents.social as |item|}}
                    <span class="nameSpan">{{skillName item.name ../this}}<select class="SelHelper2" name="system.cult.{{item.name}}">
                        {{selectOptions ../config.mirDis selected=(getData ../system/cult item.name) blank="" localize=true}}
                    </select></span> <br />
                {{/each}}

                <div class="skillFiller"></div>
                <div class="form-group subSub">
                    <div class="submen"><hr class="subhr" /></div><span class="submenlbl">{{localize "GDSA.charactersheet.natureSkills"}}</span><div class="submen"><hr class="subhr" /></div>
                </div>
                <div class="skillFiller"></div>

                {{#each template.talents.nature as |item|}}
                    <span class="nameSpan">{{skillName item.name ../this}}<select class="SelHelper2" name="system.cult.{{item.name}}">
                        {{selectOptions ../config.mirDis selected=(getData ../system/cult item.name) blank="" localize=true}}
                    </select></span> <br />
                {{/each}}

                <div class="skillFiller"></div>
                <div class="form-group subSub">
                    <div class="submen"><hr class="subhr" /></div><span class="submenlbl">{{localize "GDSA.charactersheet.knowledgeSkills"}}</span><div class="submen"><hr class="subhr" /></div>
                </div>
                <div class="skillFiller"></div>

                {{#each template.talents.knowledge as |item|}}
                    <span class="nameSpan">{{skillName item.name ../this}}<select class="SelHelper2" name="system.cult.{{item.name}}">
                        {{selectOptions ../config.mirDis selected=(getData ../system/cult item.name) blank="" localize=true}}
                    </select></span> <br />
                {{/each}}

                <div class="skillFiller"></div>
                <div class="form-group subSub">
                    <div class="submen"><hr class="subhr" /></div><span class="submenlbl">{{localize "GDSA.charactersheet.craftSkills"}}</span><div class="submen"><hr class="subhr" /></div>
                </div>
                <div class="skillFiller"></div>

                {{#each template.talents.craft as |item|}}
                    <span class="nameSpan">{{skillName item.name ../this}}<select class="SelHelper2" name="system.cult.{{item.name}}">
                        {{selectOptions ../config.mirDis selected=(getData ../system/cult item.name) blank="" localize=true}}
                    </select></span> <br />
                {{/each}}

                <div class="skillFiller"></div>
                <div class="form-group subSub">
                    <div class="submen"><hr class="subhr" /></div><span class="submenlbl">{{localize "GDSA.charactersheet.giftSkills"}}</span><div class="submen"><hr class="subhr" /></div>
                </div>
                <div class="skillFiller"></div>

                {{#each template.talents.gift as |item|}}
                    {{#unless (contains item.name "[")}}
                        <span class="nameSpan">{{skillName item.name ../this}}<select class="SelHelper2" name="system.cult.{{item.name}}">
                            {{selectOptions ../config.mirDis selected=(getData ../system/cult item.name) blank="" localize=true}}
                        </select></span> <br />
                    {{/unless}}
                {{/each}}

            </div>

        </section>
    </div>

    <button class="adBnt" data-action="close">{{localize "GDSA.charactersheet.closeLabel"}}</button>

</section>