<section>

    <div class="itemRow5">
        <div class="browserImgBox4"><img class="browserImg" name="{{item.name}}" data-edit="img" data-action="editImage" src="{{item.img}}" /></div>
        <div class="spHelper1"><b>{{localize "GDSA.itemsheet.name"}}</b></div>
        <div class="spHelper46"><input class="spHelper2" name="name" type="text" value="{{item.name}}" /></div>
        <div class="spHelper1"><b>{{localize "GDSA.template.type"}}</b></div>
        <div class="spHelper46" style="margin-bottom: -3px;">
            <select class="spHelper33" name="system.type">{{selectOptions config.tempTypes selected=system.type blank="" localize=true}}</select>
        </div>  
    </div>  

    <div class="itemMenu7">
        <nav class="tabs nav spell-tabs" data-group="spell">
            <a class="item" data-tab="spellNotes"><div class="spellMenu2">{{localize "GDSA.template.general"}}</div></a>
        </nav>
    </div>
    
    <div class="spellMenuBox">
	    <section class="spell-body">

            <div class="tab spellNotes" data-group="spell" data-tab="spellNotes">

                <div class="input100i spellName">{{localize "GDSA.trait.mAttacks"}}:</div>
                <input class="input85s" name="system.at" type="number" value="{{system.at}}" />
                <div class="input100i spellName">{{localize "GDSA.trait.mParrys"}}:</div>
                <input class="input85s" name="system.pa" type="number" value="{{system.pa}}" />
                <div class="input100i spellName">{{localize "GDSA.templates.DK"}}:</div>
                <input class="input85s" name="system.dk" type="text" value="{{system.dk}}" />
                <div class="input100i spellName">{{localize "GDSA.itemsheet.damage"}}:</div>
                <input class="input85s" name="system.tp" type="text" value="{{system.tp}}" />

            </div>

            <div class="tab spellVariants" data-group="spell" data-tab="spellVariants"></div>
            
            <div class="tab spellEffects" data-group="spell" data-tab="spellEffects"></div>

        </section>
    </div>
 
    <button class="adBnt" data-action="close">{{localize "GDSA.charactersheet.closeLabel"}}</button>

</section>