<section>

    <div class="itemDescMainBox">
        <div class="spellHeadline" style="color: white;">{{item.name}}</div>
        <div class="spellTechnik"><b style="color: white;">{{localize "GDSA.system.tech"}}:</b> {{system.spelltech}}</div>
        <div class="spellCasttime"><b style="color: white;">{{localize "GDSA.system.casttime"}}:</b> {{system.zduration}} {{localize "GDSA.system.spellaction"}}</div>
        <div class="spellEffect"><b style="color: white;">{{localize "GDSA.system.wirk"}}:</b> {{{system.spellwirk}}}</div>
        <div class="spellFact"><b style="color: white;">{{localize "GDSA.itemsheet.cost"}}:</b> 4 AsP für die Verwandlung plus 1 AsP pro Spielrunde; bei amphibischen Lebewesen 2 AsP/SR, bei wasserbewohnenden und fliegenden Lebewesen 3 AsP/SR</div>
        <div class="spellFact"><b style="color: white;">{{localize "GDSA.system.targetobj"}}:</b> {{system.targetobj}}</div>
        <div class="spellFact"><b style="color: white;">{{localize "GDSA.itemsheet.range"}}:</b> {{system.rangeSpell}}</div>
        <div class="spellFact"><b style="color: white;">{{localize "GDSA.itemsheet.wirkdu"}}:</b> nach AsP-Aufwand (vorher festlegen)</div>
        <div class="spellFact"><b style="color: white;">{{localize "GDSA.itemsheet.trait"}}:</b> {{#for 1 (countMagTrait system 1) 1}}{{localize (getData ../config.magicTraits (getData ../system (concat "trait" this "")))}}{{#unless (equals this (countMagTrait ../system 0))}},{{/unless}} {{/for}}</div>
        <div class="spellFact"><b style="color: white;">{{localize "GDSA.system.komplex"}}:</b> {{system.komp}}</div>
        <div class="spellFact"><b style="color: white;">{{localize "GDSA.system.repVer"}}:</b> {{spellVerb system}}</div>
        <div class="spellFact"><b style="color: white;">{{localize "GDSA.system.modVar"}}:</b></div>
        <div class="spellFact"><b style="color: white;">{{localize "GDSA.system.reva"}}:</b> {{system.spellreva}}</div>
        <div class="spellFact"><b style="color: white;">{{localize "GDSA.system.animag"}}:</b> {{system.spellanimag}}</div>
        <div class="spellEffect" style="font-style: italic;">{{system.spellQuote}}</div>
        <div class="spellRef">{{localize "GDSA.system.refLcd"}} {{system.lcdPage}}</div>
    </div>

    <div class="itemRow5">
        
        <div class="browserImgBox5"><img class="browserImg" name="{{item.name}}" data-edit="img" src="{{item.img}}" /></div>
        
        <div class="ritHelper22">
            <div class="spHelper47">{{localize "GDSA.itemsheet.name"}}</div>
            <div class="spHelper4">{{localize "GDSA.itemsheet.zfw"}}</div>
            <div class="spHelper49">{{localize "GDSA.itemsheet.mr"}}</div>
            <div class="spHelper47"><input class="spHelper48" name="name" type="text" value="{{item.name}}" /></div>
            <div class="spHelper50"><input class="spHelper50" name="system.zfw" type="text" value="{{system.zfw}}" /></div>
            <div class="spHelper50"><input class="mwHelper6" name="system.isMR" type="checkbox" {{checked system.isMR}} /></div>
        </div>

        <div class="ritHelper23">
            <select class="spHelper56" name="system.att1">{{selectOptions config.attributes selected=system.att1 blank="" localize=true}}</select>
            <select class="spHelper56" name="system.att2">{{selectOptions config.attributes selected=system.att2 blank="" localize=true}}</select>
            <select class="spHelper56" name="system.att3">{{selectOptions config.attributes selected=system.att3 blank="" localize=true}}</select>
            {{localize "GDSA.templates.pdf"}}<input class="ritHelper6" name="system.lcdPage" type="text" value="{{system.lcdPage}}" />
        </div>
    </div>
    

    <div class="itemMenu6">
        <nav class="tabs nav spell-tabs" data-group="spell">
            <a class="item" data-tab="spellNotes"><div class="spellMenu3">{{localize "GDSA.itemsheet.description"}}</div></a>
            <a class="item" data-tab="spellDetails"><div class="spellMenu">{{localize "GDSA.templates.detail"}}</div></a>  
            <a class="item" data-tab="spellEffects"><div class="spellMenu">{{localize "GDSA.itemsheet.cost"}}</div></a>
            <a class="item" data-tab="spellVariants"><div class="spellMenu">{{localize "GDSA.chat.skill.vari"}}</div></a>
        </nav>
    </div>

    <div class="spellMenuBox">
        <section class="spell-body">

            <div class="tab spellNotes" data-group="spell" data-tab="spellNotes">
                <div class="input100i spellName">{{localize "GDSA.system.tech"}}:</div>
                <textarea class="spellTechInput" name="system.spelltech">{{system.spelltech}}</textarea>
                <div class="input100i spellName">{{localize "GDSA.system.wirk"}}:</div>
                <textarea class="spellTechInput2" name="system.spellwirk">{{system.spellwirk}}</textarea>
                <div class="input100i spellName">{{localize "GDSA.system.reva"}}:</div>
                <textarea class="spellTechInput" name="system.spellreva">{{system.spellreva}}</textarea>
                <div class="input100i spellName">{{localize "GDSA.system.animag"}}:</div>
                <textarea class="spellTechInput" name="system.spellanimag">{{system.spellanimag}}</textarea>
                <div class="input160i spellName">{{localize "GDSA.system.ingameQuote"}}:</div>
                <textarea class="spellTechInput2" name="system.spellQuote">{{system.spellQuote}}</textarea>
                <div class="input160i spellName" style="height: 5px;"></div>
            </div>
            
            <div class="tab spellDetails" data-group="spell" data-tab="spellDetails">

                <div class="input100i spellName">{{localize "GDSA.trait.reps"}}:</div>
                <select class="input85s" name="system.rep">{{selectOptions config.magicReps selected=system.rep blank="" localize=true}}</select>
                {{#if (ifOR (equals system.rep "") (equals system.rep "none"))}}<i class="fa-solid fa-triangle-exclamation"></i>{{/if}}

                {{#for 1 (countMagTrait system 2) 1}}
                    <div class="input100i spellName">{{localize "GDSA.itemsheet.trait"}} {{this}}:</div>
                    <select class="input85s" name="system.trait{{this}}">
                        {{selectOptions ../config.magicTraits selected=(getData ../system (concat "trait" this "")) blank="" localize=true}}
                    </select>
                {{/for}}

                <div class="input100i spellName">{{localize "GDSA.system.targetobj"}}:</div>
                <select class="input85s" name="system.targetobj">{{selectOptions config.targetobj selected=system.targetobj blank="" localize=true}}</select>
                <div class="input100i spellName">{{localize "GDSA.itemsheet.range"}}:</div>
                <select class="input85s" name="system.rangeSpell">{{selectOptions config.rangeSpell selected=system.rangeSpell blank="" localize=true}}</select>

                <div class="input100i spellName">{{localize "GDSA.charactersheet.komplex"}}:</div>
                <input type="text" class="input85s" name="system.komp" value="{{system.komp}}" />
                <div class="input100i spellName">{{localize "GDSA.system.casttime"}}:</div>
                <input type="number" class="input85s" name="system.zduration" value="{{system.zduration}}" />

                <div class="spellLine">{{localize "GDSA.system.avaMod"}}:</div>
                <div class="spellModiBox" style="margin-left: 20px;">
                    <div class="spellHelper"><input class="mwHelper1" name="system.technic" type="checkbox" {{checked system.technic}} /></div> <span class="spellModSel">{{localize "GDSA.system.tech"}}</span> <br />
                    <div class="spellHelper"><input class="mwHelper1" name="system.casttime" type="checkbox" {{checked system.casttime}} /></div> <span class="spellModSel">{{localize "GDSA.system.casttime"}}</span>
                </div>
                <div class="spellModiBox">
                    <div class="spellHelper"><input class="mwHelper1" name="system.forced" type="checkbox" {{checked system.forced}} /></div> <span class="spellModSel">{{localize "GDSA.system.force"}}</span> <br />
                    <div class="spellHelper"><input class="mwHelper1" name="system.cost" type="checkbox" {{checked system.cost}} /></div> <span class="spellModSel">{{localize "GDSA.itemsheet.cost"}}</span>
                </div>
                <div class="spellModiBox">
                    <div class="spellHelper"><input class="mwHelper1" name="system.range" type="checkbox" {{checked system.range}} /></div> <span class="spellModSel">{{localize "GDSA.system.reach"}}</span> <br />
                    <div class="spellHelper"><input class="mwHelper1" name="system.duration" type="checkbox" {{checked system.duration}} /></div> <span class="spellModSel">{{localize "GDSA.system.duration"}}</span>
                </div>

                <div class="spellLine">{{localize "GDSA.system.verbr"}}:</div>
                <div class="spellModiBox" style="margin-left: 20px;">
                    <div class="spellVLine"><div class="spellVName">Mag</div><input class="input40" name="system.vMag" type="number" value="{{system.vMag}}" /></div>
                    <div class="spellVLine"><div class="spellVName">Dru</div><input class="input40" name="system.vDru" type="number" value="{{system.vDru}}" /></div>
                    <div class="spellVLine"><div class="spellVName">Bor</div><input class="input40" name="system.vBor" type="number" value="{{system.vBor}}" /></div>
                </div>
                <div class="spellModiBox">
                    <div class="spellVLine"><div class="spellVName">Srl</div><input class="input40" name="system.vSrl" type="number" value="{{system.vSrl}}" /></div>
                    <div class="spellVLine"><div class="spellVName">Hex</div><input class="input40" name="system.vHex" type="number" value="{{system.vHex}}" /></div>
                    <div class="spellVLine"><div class="spellVName">Elf</div><input class="input40" name="system.vElf" type="number" value="{{system.vElf}}" /></div>
                </div>
                <div class="spellModiBox">
                    <div class="spellVLine"><div class="spellVName">Sch</div><input class="input40" name="system.vSch" type="number" value="{{system.vSch}}" /></div>
                    <div class="spellVLine"><div class="spellVName">Geo</div><input class="input40" name="system.vGeo" type="number" value="{{system.vGeo}}" /></div>
                    <div class="spellVLine"><div class="spellVName">Ach</div><input class="input40" name="system.vAch" type="number" value="{{system.vAch}}" /></div>
                </div>
            </div>

            <div class="tab spellVariants" data-group="spell" data-tab="spellVariants">
                {{#each system.vars}}
                    <div class="variantbox" data-id="{{@index}}">
                        <b>{{name}}</b> {{#if (isGreater minZfW 1)}}({{localize "GDSA.itemsheet.abZfW"}} {{minZfW}}){{/if}}<br />
                        {{#if (isGreater disad 0)}}<b>{{localize "GDSA.itemsheet.disad"}}:</b> +{{disad}}<br />{{/if}}
                        {{#if (isGreater cost.length 2)}}<b>{{localize "GDSA.itemsheet.cost"}}:</b> {{cost}} {{localize "GDSA.itemsheet.asp"}}<br />
                        {{else}} {{#if (isGreater cost 0)}}<b>{{localize "GDSA.itemsheet.cost"}}:</b> {{cost}} {{localize "GDSA.itemsheet.asp"}}<br />{{/if}}{{/if}}
                        {{#if (isGreater casttime 0)}}<b>{{localize "GDSA.itemsheet.casttime"}}:</b> {{casttime}}<br />{{/if}}
                        {{#if (isGreater resti.length 0)}}<b>{{localize "GDSA.itemsheet.restriction"}}:</b> {{displayRegla resti}}{{/if}}
                        <div class="buttonbox">
                            <a class="editSpellVariants"><i class="fa-regular fa-gear spellvari"></i></a>
                            <a class="deleteSpellVariants"><i class="fa-solid fa-trash spellvari"></i></a>
                        </div>
                    </div>        
                {{/each}}
                <a class="addSpellVariants"><div class="plusVariants">+</div></a>
            </div>
            
            <div class="tab spellEffects" data-group="spell" data-tab="spellEffects">

                <div class="input100 spellName">{{localize "GDSA.itemsheet.cost"}}:</div>
                <input class="input60c" name="system.costs" type="text" value="{{system.costs}}" />

                <div class="input100f">
                    <input class="mwHelper5" name="system.diffrentCost" type="checkbox" {{checked system.diffrentCost}} />
                    <select class="input70a" name="system.repAlt" {{#unless system.diffrentCost}}disabled{{/unless}}>
                        {{selectOptions config.magicReps selected=system.repAlt blank="" localize=true}}
                    </select>
                    <input class="input60c" name="system.costsAlt" type="text" value="{{system.costsAlt}}" {{#unless system.diffrentCost}}disabled{{/unless}}/> 
                </div>

            </div>
            
        </section>
    </div>

    <button class="adBnt2" data-action="close">{{localize "GDSA.charactersheet.closeLabel"}}</button>

</section>