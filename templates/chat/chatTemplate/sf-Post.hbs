<div class="GDSA chat message skill">
    {{doLog this}}
    <div class="chathrBox"><hr class="chathr" /></div>
    
    <div class="chatheadline2">{{name}}</div>

    <div id="collapsable">
        <div class="chathrBox"><hr class="chathrBold" /></div>
        <span class="chatUnterlineInfo">~ Verbreitung {{system.sf.ver}} - {{system.sf.apCost}} AP ~</span>
        <span class="chatMainInfo">{{system.sf.description}}</span>
    </div>
    
    <span id="additionalInfo" class="chatQuellInfo">WDH {{system.sf.wdh}}</span>

</div>